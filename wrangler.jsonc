{
  // Static site plus one small Worker. `nuxt generate` prerenders the whole
  // site to .output/public and `wrangler deploy` uploads it to Cloudflare's
  // edge. The Worker (worker/index.ts) is the contact terminal's `mail`
  // endpoint and nothing else: `run_worker_first` hands it `/api/*` only, so
  // every page and asset is still served directly from the asset store.
  // No D1.
  "name": "fabraham",
  // Pinned so a deploy can't land on another account the login can see.
  "account_id": "5bba05afbd252add74fdd4573c985080",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-15",
  "assets": {
    "directory": "./.output/public",
    "run_worker_first": ["/api/*"],
    // One spelling per page: /projects/index.html is served at /projects, and
    // /projects/ redirects there. That matches the canonical and hreflang URLs
    // @nuxtjs/i18n writes (no trailing slash), so no canonical points at a
    // redirect. The default, auto-trailing-slash, did the opposite.
    "html_handling": "drop-trailing-slash",
    // A miss gets Nuxt's prerendered 404.html from the asset store instead of
    // falling through to the Worker, whose own 404 is JSON for the API.
    "not_found_handling": "404-page"
  },
  // www is not served from here: wrangler.www.jsonc deploys a separate,
  // tiny Worker on www.fabraham.dev that 301s to the bare domain. Keeping it
  // separate means the asset requests on fabraham.dev never invoke a Worker.
  "routes": [
    { "pattern": "fabraham.dev", "custom_domain": true }
  ],
  "vars": {
    // The frontend hostnames siteverify must report. Production only, never
    // localhost.
    "TURNSTILE_HOSTNAMES": "fabraham.dev,www.fabraham.dev"
  }
  // Secrets (`wrangler secret put …`), deliberately not in this file:
  //   TURNSTILE_SECRET    the Turnstile widget's secret key
  //   TELEGRAM_BOT_TOKEN  the bot's token, from @BotFather
  //   TELEGRAM_CHAT_ID    the chat the bot writes to
}
